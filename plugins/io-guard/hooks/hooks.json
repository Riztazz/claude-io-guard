{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|Read|Grep|Glob|mcp__plugin_io-guard_io__io_run|mcp__plugin_io-guard_io__io_restore|mcp__plugin_io-guard_io__io_trust",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:io-guard:io",
            "tool": "hook.pre_tool_use",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}",
              "prompt_id": "${prompt_id}",
              "tool_name": "${tool_name}",
              "cwd": "${cwd}",
              "scratchpad_dir": "${scratchpad_dir}",
              "transcript_path": "${transcript_path}",
              "permission_mode": "${permission_mode}",
              "agent_id": "${agent_id}",
              "tool_input": "${tool_input}"
            }
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|Read|Grep|Glob",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:io-guard:io",
            "tool": "hook.post_tool_use",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}",
              "prompt_id": "${prompt_id}",
              "tool_name": "${tool_name}",
              "cwd": "${cwd}",
              "scratchpad_dir": "${scratchpad_dir}",
              "transcript_path": "${transcript_path}",
              "permission_mode": "${permission_mode}",
              "agent_id": "${agent_id}",
              "tool_input": "${tool_input}",
              "tool_response": "${tool_response}"
            }
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash|PowerShell|Edit|Write|Read|Grep|Glob",
        "hooks": [
          {
            "type": "mcp_tool",
            "server": "plugin:io-guard:io",
            "tool": "hook.post_tool_use_failure",
            "input": {
              "hook_event_name": "${hook_event_name}",
              "session_id": "${session_id}",
              "tool_use_id": "${tool_use_id}",
              "prompt_id": "${prompt_id}",
              "tool_name": "${tool_name}",
              "cwd": "${cwd}",
              "scratchpad_dir": "${scratchpad_dir}",
              "transcript_path": "${transcript_path}",
              "permission_mode": "${permission_mode}",
              "agent_id": "${agent_id}",
              "tool_input": "${tool_input}",
              "error": "${error}"
            }
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" session_start"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"${CLAUDE_PLUGIN_ROOT}/scripts/pyrun\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hook.py\" heartbeat"
          }
        ]
      }
    ]
  }
}
